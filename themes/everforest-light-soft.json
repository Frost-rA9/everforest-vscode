    {
      "name": "JSDoc tag",
      "scope": "punctuation.definition.block.tag.jsdoc",
      "settings": {
        "foreground": "#F85552"
      }
    },
    {
      "name": "Python parameter",
      "scope": "variable.parameter.function.python",
      "settings": {
        "foreground": "#5C6A72"
      }
